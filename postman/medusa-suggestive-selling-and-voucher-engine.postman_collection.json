                "{{productId}}",
                "suggestions"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3",
                  "disabled": true
                }
              ]
            },
            "description": "GET /store/products/:id/suggestions — SUGG-001/002 product-level recommendations (filters BR-02)"
          }
        },
        {
          "name": "Cart-Level Suggestions (CR-01..04)",
