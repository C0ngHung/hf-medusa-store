meta {
  name: GET cart suggestions (2.5.2)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/store/carts/{{cartId}}/suggestions?limit=3
  body: none
  auth: none
}

params:query {
  limit: 3
}

headers {
  x-publishable-api-key: {{publishableKey}}
  x-session-id: {{sessionId}}
}

tests {
  test("200 OK (never 5xx — BR-10)", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("suggestions is an array", function () {
    expect(res.getBody().suggestions).to.be.an('array');
  });
  test("count matches length", function () {
    expect(res.getBody().count).to.equal(res.getBody().suggestions.length);
  });
  test("at most CART_LIMIT=3", function () {
    expect(res.getBody().suggestions.length).to.be.at.most(3);
  });
  test("threshold_info present (null unless CR-02 fired)", function () {
    expect(res.getBody()).to.have.property('threshold_info');
  });
}
