    },
    {
      "key": "adminEmail",
      "value": "admin@admin.com"
    },
    {
      "key": "adminPassword",
      "value": "supersecret"
    },
    {
      "key": "token",
      "value": "",
      "description": "admin JWT — auto-filled by Setup › Login"
    },
    {
      "key": "publishableKey",
      "value": "pk_160f5ac26e56619f4b1913353ebac7932a8c390e6a6379879df59db4a8b34de7",
      "description": "x-publishable-api-key (Default from seed). Re-fetch via Setup › Get publishable key if rotates."
    },
    {
      "key": "sessionId",
      "value": "sess_postman_demo",
      "description": "x-session-id — scopes dismissal set + analytics (D6/SEC-04)"
    },
    {
      "key": "regionId",
      "value": "reg_01KX54P002XZTC793GRS1QMW53",
      "description": "Vietnam / VND (from seed)"
    },
    {
      "key": "productId",
      "value": "prod_01KX5SXC11R4JQY12RFMQ5KDW2",
      "description": "apacs-astrox-77 (source for product suggestions)"
    },
    {
      "key": "cartId",
      "value": "",
      "description": "created by Setup › Create Cart"
    },
    {
      "key": "voucherCode",
      "value": "SUMMER50",
      "description": "voucher code to test"
    },
    {
      "key": "voucherId",
      "value": "",
      "description": "voucher UUID (from list or create)"
    },
    {
      "key": "promotionId",
      "value": "",
      "description": "native Promotion id — used by Admin › Promotions x VoucherEngine (Unified Model) to attach/read/disable a linked VoucherConfig"
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  pm.test('Token extracted', () => pm.expect(json.access_token).to.exist);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/user/emailpass",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "user", "emailpass"]
            }
          }
        },
        {
          "name": "Get Publishable Key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/publishable-api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "publishable-api-keys"]
            }
          }
        },
        {
          "name": "Create Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.cart && json.cart.id) {",
                  "  pm.collectionVariables.set('cartId', json.cart.id);",
                  "  pm.test('Cart created', () => pm.expect(json.cart.id).to.exist);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"region_id\": \"{{regionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/carts",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts"]
            }
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variant_id\": \"variant_01KX5SXCZAYBXJZTKGQ64RJE4C\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/carts/{{cartId}}/line-items",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts", "{{cartId}}", "line-items"]
            }
          }
        }
      ]
    },
    {
      "name": "Store — Suggestive Selling",
      "item": [
        {
          "name": "Product-Level Suggestions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/products/{{productId}}/suggestions",
              "host": ["{{baseUrl}}"],
              "path": ["store", "products", "{{productId}}", "suggestions"],
              "query": [
                {
                  "key": "limit",
                  "value": "3",
                  "disabled": true
                }
              ]
            },
            "description": "GET /store/products/:id/suggestions — SUGG-001/002 product-level recommendations (filters BR-02)"
          }
        },
        {
          "name": "Cart-Level Suggestions (CR-01..04)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              },
              {
                "key": "x-session-id",
                "value": "{{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/carts/{{cartId}}/suggestions",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts", "{{cartId}}", "suggestions"],
              "query": [
                {
                  "key": "limit",
                  "value": "3",
                  "disabled": true
                },
                {
                  "key": "dismissed_product_ids",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "GET /store/carts/:id/suggestions — SUGG-004 cart-level rules CR-01..CR-04 (category missing, threshold nudge, same-brand, consumable upsell)"
          }
        },
        {
          "name": "Add Suggested Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variant_id\": \"variant_01KX5SXCZAYBXJZTKGQ64RJE4C\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/carts/{{cartId}}/suggested-items",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts", "{{cartId}}", "suggested-items"]
            },
            "description": "POST /store/carts/:id/suggested-items — add suggested item with attribution (rule_id, tier)"
          }
        },
        {
          "name": "Log Suggestion Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              },
              {
                "key": "x-session-id",
                "value": "{{sessionId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"view\",\n  \"product_id\": \"{{productId}}\",\n  \"cart_id\": \"{{cartId}}\",\n  \"rule_id\": \"rule_id_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/suggestion-events",
              "host": ["{{baseUrl}}"],
              "path": ["store", "suggestion-events"]
            },
            "description": "POST /store/suggestion-events — analytics (view/filter/add events, 2.6.8–2.6.12)"
          }
        }
      ]
    },
    {
      "name": "Store — VoucherEngine",
      "item": [
        {
          "name": "Apply Voucher to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{voucherCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/carts/{{cartId}}/voucher?replace=true",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts", "{{cartId}}", "voucher"],
              "query": [
                {
                  "key": "replace",
                  "value": "true",
                  "disabled": true,
                  "description": "confirm replacing an already-active voucher (otherwise 409 VOUCHER_REPLACE_REQUIRED)"
                }
              ]
            },
            "description": "POST /store/carts/:id/voucher — apply voucher code (validation V1–V8, cap enforcement). Optional ?replace=true confirms swapping an active voucher."
          }
        },
        {
          "name": "Remove Voucher from Cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/carts/{{cartId}}/voucher",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts", "{{cartId}}", "voucher"]
            },
            "description": "DELETE /store/carts/:id/voucher — detach voucher, revalidate cart"
          }
        },
        {
          "name": "Get My Vouchers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/customers/me/vouchers?cart_id={{cartId}}",
              "host": ["{{baseUrl}}"],
              "path": ["store", "customers", "me", "vouchers"],
              "query": [
                {
                  "key": "cart_id",
                  "value": "{{cartId}}",
                  "disabled": true,
                  "description": "adds eligible/ineligible_reason/estimated_savings per voucher against this cart"
                }
              ]
            },
            "description": "GET /store/customers/me/vouchers — list customer's applied + redeemed vouchers (Day 4, 3.5.8). Guest requests 401 here (Medusa's core /store/customers/me/* middleware authenticates unconditionally) — use GET /store/vouchers for a guest-reachable equivalent."
          }
        },
        {
          "name": "List Available Vouchers (Public/Guest)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/vouchers?cart_id={{cartId}}",
              "host": ["{{baseUrl}}"],
              "path": ["store", "vouchers"],
              "query": [
                {
                  "key": "cart_id",
                  "value": "{{cartId}}",
                  "disabled": true,
                  "description": "adds eligible/ineligible_reason/estimated_savings per voucher against this cart"
                }
              ]
            },
            "description": "GET /store/vouchers — public, auth-OPTIONAL available-vouchers list. Guests see every valid, unrestricted voucher; an authenticated customer (attach a Bearer token) additionally sees vouchers gated to a Customer Group they belong to. Lives outside /store/customers/me/* specifically so guests can reach it (that prefix's core middleware would otherwise 401 them). Read-only, no workflow."
          }
        }
      ]
    },
