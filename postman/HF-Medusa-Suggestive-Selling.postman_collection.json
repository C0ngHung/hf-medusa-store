            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "3.4.13 — `discount_value: 0` là voucher vô nghĩa → schema chặn (`min 1`) → **400**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"discount_type\": \"percentage\",\n  \"discount_value\": 0,\n  \"valid_from\": \"2026-01-01T00:00:00.000Z\",\n  \"valid_to\": \"2026-12-31T23:59:59.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
