# Template for apps/backend/.env.test (copy to .env.test; .env.* is gitignored).
# Required to run `pnpm test:integration:http` / `pnpm test:integration:modules`.
#
# The Medusa integration test runner (@medusajs/test-utils) creates/drops a
# throwaway test database and reads its connection from these DB_* vars — NOT from
# DATABASE_URL. Point them at your local Postgres (docker-compose default below).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=your_pg_user
DB_PASSWORD=your_pg_password

# Leave PORT empty so the runner auto-picks a free port (avoids colliding with a
# running dev server on 9009).
PORT=

# Leave REDIS_URL empty to run infra modules in-memory during tests. This avoids
# bullmq (redis workflow-engine/event-bus) teardown errors that otherwise fail the
# suite. Set it to a real Redis URL only if a test specifically needs Redis.
REDIS_URL=
