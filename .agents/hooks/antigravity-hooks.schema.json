{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hf-medusa-store.local/schemas/antigravity-hooks.schema.json",
  "title": "Antigravity native lifecycle hooks",
  "description": "Shape documented by ~/.gemini/antigravity-cli/builtin/skills/agy-customizations/docs/hooks.md: the file is a map of hook name to event configuration.",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"}
  },
  "additionalProperties": {"$ref": "#/$defs/namedHook"},
  "$defs": {
    "namedHook": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "PreToolUse": {"type": "array", "items": {"$ref": "#/$defs/matchedGroup"}},
        "PostToolUse": {"type": "array", "items": {"$ref": "#/$defs/matchedGroup"}},
        "PreInvocation": {"type": "array", "items": {"$ref": "#/$defs/handler"}},
        "PostInvocation": {"type": "array", "items": {"$ref": "#/$defs/handler"}},
        "Stop": {"type": "array", "items": {"$ref": "#/$defs/handler"}}
      },
      "additionalProperties": false
    },
    "matchedGroup": {
      "type": "object",
      "required": ["matcher", "hooks"],
      "properties": {
        "matcher": {"type": "string"},
        "hooks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/handler"}}
      },
      "additionalProperties": false
    },
    "handler": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "type": {"const": "command"},
        "command": {"type": "string", "minLength": 1},
        "timeout": {"type": "integer", "minimum": 1, "maximum": 300}
      },
      "additionalProperties": false
    }
  }
}
