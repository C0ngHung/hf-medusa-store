    {
      "name": "2.6.1 / 2.6.6 · cart.updated → cache invalidation (flow)",
      "description": "Demonstrates cache-aside + invalidation. Run 1→2→3 in order (needs Setup done). Step 1 warms the cart cache; step 2 mutates the cart (emits cart.updated → subscriber DELs suggest:cart:v{ver}:{cartId}); step 3 recomputes on the fresh state. Behaviour is identical to GET cart suggestions above — grouped here as a narrative.",
      "item": [
        {
          "name": "1) GET cart suggestions (warm cache)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('shape ok', () => pm.expect(pm.response.json().suggestions).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "x-publishable-api-key", "value": "{{publishableKey}}" },
              { "key": "x-session-id", "value": "{{sessionId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/carts/{{cartId}}/suggestions",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts", "{{cartId}}", "suggestions"]
            }
          }
        },
        {
          "name": "2) Add grip to cart (emits cart.updated → invalidate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "// cart.updated fires → cart-updated-suggestions subscriber invalidates the cart cache (2.6.6)."
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-publishable-api-key", "value": "{{publishableKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variant_id\": \"{{gripVariantId}}\",\n  \"quantity\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/store/carts/{{cartId}}/line-items",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts", "{{cartId}}", "line-items"]
            }
          }
        },
        {
          "name": "3) GET cart suggestions (recomputed on fresh state)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('shape ok', () => pm.expect(j.count).to.eql(j.suggestions.length));",
                  "pm.test('grip now in cart is not re-suggested (2.3.1)', () => {",
                  "  j.suggestions.forEach((s) => pm.expect(s.product_id).to.not.eql(pm.collectionVariables.get('gripVariantId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "x-publishable-api-key", "value": "{{publishableKey}}" },
              { "key": "x-session-id", "value": "{{sessionId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/carts/{{cartId}}/suggestions",
              "host": ["{{baseUrl}}"],
              "path": ["store", "carts", "{{cartId}}", "suggestions"]
            }
