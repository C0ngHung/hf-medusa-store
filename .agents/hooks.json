{
  "$schema": "hooks/antigravity-hooks.schema.json",
  "workspace-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/validate-tool-call.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
