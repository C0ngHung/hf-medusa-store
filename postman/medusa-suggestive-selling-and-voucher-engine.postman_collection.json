    {
      "name": "Admin — Vouchers (Management)",
      "item": [
        {
          "name": "Create Voucher Config",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.voucher && json.voucher.id) {",
                  "  pm.collectionVariables.set('voucherId', json.voucher.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SUMMER50\",\n  \"discount_type\": \"percentage\",\n  \"discount_value\": 5000,\n  \"min_order_value\": 100000,\n  \"max_discount_amount\": 200000,\n  \"per_user_limit\": 1,\n  \"usage_limit\": 100,\n  \"is_active\": true,\n  \"valid_from\": \"2026-07-01T00:00:00Z\",\n  \"valid_to\": \"2026-08-31T23:59:59Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/vouchers",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "vouchers"]
            },
            "description": "POST /admin/vouchers — create voucher config (Day 4, 3.6.1; CreateVoucherSchema). `discount_value` is basis-points for percentage (5000 = 50%), raw VND for fixed_amount. `code` is optional (auto-generated when omitted). This is the atomic-create fallback — the primary Admin flow is native Promotions + `POST /admin/promotions/:promotion_id/voucher-config` below. NOTE: `GET /admin/vouchers` (list) was retired 2026-07-21 in favor of the unified Promotion model; only POST remains on this route."
          }
        },
        {
          "name": "Get Voucher Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/vouchers/{{voucherId}}/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "vouchers", "{{voucherId}}", "analytics"]
            },
            "description": "GET /admin/vouchers/:id/analytics — voucher usage stats (redemptions, revenue, top products)"
          }
        }
      ]
    },
    {
      "name": "Admin — Discount Cap Config",
      "item": [
        {
          "name": "Get Discount Cap Config",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/discount-cap-config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "discount-cap-config"]
            },
            "description": "GET /admin/discount-cap-config — the single active global cap row (SRS §5.2). Returns a synthetic default (`id: null`, DEFAULT_CAP_PCT) when no row exists yet — never 404, since a cap is always effectively in force."
          }
        },
        {
          "name": "Upsert Discount Cap Config",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"max_discount_percentage\": 5000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/discount-cap-config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "discount-cap-config"]
            },
            "description": "POST /admin/discount-cap-config — upsert the single active cap row. `max_discount_percentage` is integer basis points in [0, 10000] (5000 = 50.00%). Updates the existing active row if one exists; otherwise creates it — never creates a second active row."
          }
        }
      ]
    },
    {
      "name": "Admin — Promotions × VoucherEngine (Unified Model)",
      "item": [
        {
          "name": "Enable VoucherEngine on Promotion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.voucher && json.voucher.id) {",
                  "  pm.collectionVariables.set('voucherId', json.voucher.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"min_order_value\": 100000,\n  \"max_discount_amount\": 200000,\n  \"per_user_limit\": 1,\n  \"valid_from\": \"2026-07-01T00:00:00Z\",\n  \"valid_to\": \"2026-08-31T23:59:59Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/promotions/{{promotionId}}/voucher-config",
              "host": ["{{baseUrl}}"],
              "path": [
                "admin",
                "promotions",
                "{{promotionId}}",
                "voucher-config"
              ]
            },
            "description": "POST /admin/promotions/:promotion_id/voucher-config — \"Enable VoucherEngine\" on an existing native Promotion. Idempotent: creates a linked VoucherConfig, or reactivates/updates the existing one. Deliberately excludes code/discount_type/discount_value/status/usage_limit — those stay owned by the native Promotion/Campaign UI (or, for usage_limit, are seeded once from it)."
          }
        },
        {
          "name": "Get VoucherConfig for Promotion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/promotions/{{promotionId}}/voucher-config",
              "host": ["{{baseUrl}}"],
              "path": [
                "admin",
                "promotions",
                "{{promotionId}}",
                "voucher-config"
              ]
            },
            "description": "GET /admin/promotions/:promotion_id/voucher-config — read-only lookup of the VoucherConfig linked to this Promotion. Returns `{ voucher: null }` (not 404) when nothing is linked. Native fields are overlaid via resolveVoucherNativeFields so this always agrees with what the cart-apply path enforces."
          }
        },
        {
          "name": "Disable VoucherEngine on Promotion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/promotions/{{promotionId}}/voucher-config",
              "host": ["{{baseUrl}}"],
              "path": [
                "admin",
                "promotions",
                "{{promotionId}}",
                "voucher-config"
              ]
            },
            "description": "DELETE /admin/promotions/:promotion_id/voucher-config — \"Disable VoucherEngine\", reversible: sets is_active: false on the linked VoucherConfig without deleting the Promotion, usage history, or analytics. No-op success when nothing is linked."
          }
        }
      ]
    },
