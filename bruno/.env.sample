# Bruno dotenv — copy sang `.env` (gitignored) hoặc chạy `scripts/sync-env.sh` để tự sinh.
# Bruno tự nạp file .env trong thư mục collection này và expose qua {{process.env.VAR}}.

# Publishable API key cho các request Store (/store/*). Lấy từ DB
# (api_key.token where type='publishable') — KHÔNG commit key vào git.
PUBLISHABLE_KEY=pk_xxx

# (tuỳ chọn) Base URL nếu muốn override — mặc định environments/local.bru đã set http://localhost:9009
# BASE_URL=http://localhost:9009
